// Una Semana es un cierre (Lunes a Domingo) y nunca se borra: es el historial.
// Cada Semana tiene hasta 7 DiaCierre con los montos de efectivo y sinpe.
// Los montos son colones enteros (Int), sin céntimos.
// Más adelante se agrega el usuario dueño del cierre.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Semana {
  id            Int         @id @default(autoincrement())
  fechaInicio   DateTime    @unique @db.Date // siempre un lunes
  fechaFin      DateTime    @db.Date // siempre el domingo siguiente
  creadaEn      DateTime    @default(now())
  actualizadaEn DateTime    @default(now()) @updatedAt
  dias          DiaCierre[]

  @@map("semanas")
}

model DiaCierre {
  id       Int      @id @default(autoincrement())
  semanaId Int
  semana   Semana   @relation(fields: [semanaId], references: [id])
  fecha    DateTime @db.Date
  efectivo Int      @default(0)
  sinpe    Int      @default(0)

  @@unique([semanaId, fecha])
  @@map("dias_cierre")
}

// Quien puede entrar a la app. Sin registro público: se crean con `npm run crear-usuario`.
model Usuario {
  id               Int       @id @default(autoincrement())
  nombre           String    @unique // siempre en minúsculas
  claveHash        String // "sal:hash" (scrypt), ver src/lib/clave.ts
  creadoEn         DateTime  @default(now())
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  @@map("usuarios")
}
